<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="item"
            type="com.example.np_team_k.ui.list.ListItem" />
        <variable
            name="clickHandler"
            type="com.example.np_team_k.ui.list.ReactionClickHandler" />
    </data>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:layout_marginHorizontal="12dp"
        android:background="@android:color/transparent"
        app:cardElevation="4dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical|end"
        android:background="@drawable/bg_state_item">

        <!-- 텍스트 바인딩 -->
        <TextView
            android:id="@+id/text_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="@{item.text}"
            android:textColor="@android:color/black"
            android:textSize="14sp"
        />

        <!-- 리액션 아이콘들 + 클릭 핸들러 예시 -->
        <ImageView
            android:id="@+id/icon_heart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:src='@{item.selectedReaction == "HEART" ? @drawable/ic_heart_full : @drawable/ic_heart_empty}'
            android:onClick='@{() -> clickHandler.onReactionClick(item.id, "HEART")}'
            android:contentDescription="heart" />

        <ImageView
            android:id="@+id/icon_funny"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:src='@{item.selectedReaction == "FUNNY" ? @drawable/ic_funny_full : @drawable/ic_funny_empty}'
            android:onClick='@{() -> clickHandler.onReactionClick(item.id, "FUNNY")}'
            android:contentDescription="ㅋㅋ" />

        <ImageView
            android:id="@+id/icon_thumb"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:src='@{item.selectedReaction == "THUMB" ? @drawable/ic_thumb_full : @drawable/ic_thumb_empty}'
            android:onClick='@{() -> clickHandler.onReactionClick(item.id, "THUMB")}'
            android:contentDescription="thumb up" />

        <ImageView
            android:id="@+id/icon_sad"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:src='@{item.selectedReaction == "SAD" ? @drawable/ic_sad_full : @drawable/ic_sad_empty}'
            android:onClick='@{() -> clickHandler.onReactionClick(item.id, "SAD")}'
            android:contentDescription="sad" />


    </LinearLayout>
</androidx.cardview.widget.CardView>
</layout>


